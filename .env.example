# Kopieren nach .env und anpassen (alles optional)
# Startport; ist er belegt, wird automatisch der nächste freie genommen
BORA_PORT=8088
# Anzahl Ports, die probiert werden (1 = genau BORA_PORT, sonst Abbruch)
BORA_PORT_SEARCH=100
# Reservierte Ports, die nie verwendet werden (8090 = BORA-Anwendung), z.B. 8080,8090,9000-9010
BORA_PORT_EXCLUDE=8080,8090
# Log-Verzeichnis auf dem Host (wird read-only eingebunden)
BORA_LOG_DIR=./sources
BORA_USER=
BORA_PASSWORD=
# Image aus der Registry (Standard) oder eigener Name
#BORA_IMAGE=ghcr.io/icoglu/bora-rodaten-optimizer:latest

# --- Nur bei Build-Problemen im Firmennetz ---
# Internes Basis-Image statt Docker Hub
#BASE_IMAGE=registry.firma.de/python:3.12-slim
# Interner pip-Mirror (Nexus/Artifactory)
#PIP_INDEX_URL=https://nexus.firma.de/repository/pypi/simple
#PIP_TRUSTED_HOST=nexus.firma.de
# Proxy für den Build
#HTTP_PROXY=http://proxy.firma.de:8080
#HTTPS_PROXY=http://proxy.firma.de:8080
#NO_PROXY=localhost,127.0.0.1,.firma.de
# Firmen-Root-Zertifikat bei TLS-Inspection: als PEM nach certs/firma.crt
